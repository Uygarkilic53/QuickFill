{
  "manifest_version": 3,
  "name": "QuickFill",
  "version": "1.0",
  "description": "Securely stores login credentials and autofills them with one click.",
  "minimum_chrome_version": "109",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms",
    "offscreen",
    "clipboardWrite"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+Q"
      },
      "description": "Open QuickFill"
    },
    "fill_active": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Fill the login form on the current site"
    }
  },
  "icons": {
    "16": "images/icon.png",
    "32": "images/icon.png",
    "48": "images/icon.png",
    "128": "images/icon.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "QuickFill",
    "default_icon": {
      "16": "images/icon.png",
      "32": "images/icon.png",
      "48": "images/icon.png",
      "128": "images/icon.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
